# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# Seed admin (used ONLY by: npm run seed:admin):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
