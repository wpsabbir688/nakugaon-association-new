# Copy to .env — NEVER commit a real .env, secret, password, or DB URI.
PORT=5000
NODE_ENV=development
# PostgreSQL — DIRECT (non-pooled) URL only; pooled URLs reject Prisma
# interactive transactions. NEVER use the old live `nakugaon` Neon database;
# this project needs its own separate database (see docs/POSTGRES_MIGRATION.md).
# Local dev example (see server/scripts/local-postgres.sh):
DATABASE_URL=postgresql://nakugaon@127.0.0.1:5433/nakugaon_dev
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Optional SMTP (if unset, password reset is LOG-ONLY and the API says so honestly):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# Seed admin (used ONLY by: npm run seed:admin):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
