# Copy to .env — NEVER commit a real .env, secret, password, or DB URI.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/nakugaon
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
