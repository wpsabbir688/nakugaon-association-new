{
  "name": "nakugaon-association-server",
  "version": "1.0.0",
  "private": true,
  "description": "Nakugaon Import & Export Owners Association — backend API (BDT integer accounting)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint src tests || true",
    "replace:admin": "node src/scripts/replace-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
